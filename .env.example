# Project Runtime Environment
ENVIRONMENT=production

# Server Binding & CORS
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://assistant.csjmu.ac.in

# Authentication & Secrets (ALWAYS REPLACE WITH SECURE RANDOM VALUES)
ADMIN_PASSCODE=<your-admin-passcode>
ADMIN_SESSION_SECRET=<generate-a-random-32-char-secret>

# LLM Provider Selection ("openrouter" or "ollama")
LLM_PROVIDER=ollama

# Embedding Provider Selection ("ollama" or "openrouter")
EMBEDDING_PROVIDER=ollama

# OpenRouter Configuration (Fallback Option)
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free


# Remote DGX Ollama Configuration
OLLAMA_BASE_URL=http://172.20.8.10:31435
OLLAMA_LLM_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text:latest

# ChromaDB Vector Store
COLLECTION_NAME=collection50
DEFAULT_K=7

