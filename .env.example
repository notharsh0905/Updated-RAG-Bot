# Project Runtime Environment
ENVIRONMENT=production

# Server Binding & CORS
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://assistant.csjmu.ac.in

# Authentication & Secrets (ALWAYS REPLACE WITH SECURE RANDOM VALUES)
ADMIN_PASSCODE=<your-admin-passcode>
ADMIN_SESSION_SECRET=<generate-a-random-32-char-secret>

# LLM Provider Selection ("openrouter" or "ollama")
LLM_PROVIDER=openrouter

# Embedding Provider Selection ("ollama" or "openrouter")
EMBEDDING_PROVIDER=ollama

# OpenRouter Configuration (NVIDIA Nemotron Nano 9B V2 Free & Nemotron 3 Embed 1B Free)
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free


# Ollama Configuration (Local Fallback Option)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB Vector Store
COLLECTION_NAME=collection50
DEFAULT_K=7

